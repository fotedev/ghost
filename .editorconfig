root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
